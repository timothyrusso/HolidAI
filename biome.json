{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@timothyrusso/config-presets/biome"],
  "files": {
    "includes": [
      "!**/convex/_generated",
      "!**/.rnstorybook/storybook.requires.ts",
      "!**/.claude/settings.local.json",
      "!**/features/core/design-system/assets/lottie"
    ]
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "**/features/core/state/libraries/createSelectors.ts",
        "**/features/core/state/libraries/createStore.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
