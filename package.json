{
  "name": "holidai",
  "main": "index.js",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "e2e": "maestro test ./maestro",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:generate": "sb-rn-get-stories --config-path ./.rnstorybook",
    "storybook:ios": "npm run storybook:generate && EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:ios",
    "storybook:android": "npm run storybook:generate && EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:android",
    "spell-check": "cspell lint .",
    "format": "npx @biomejs/biome format --write",
    "lint": "npx @biomejs/biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "lint:compiler": "npx eslint \"**/*.{js,jsx,ts,tsx}\"",
    "test:eslint-rules": "node tools/eslint/tests/run.js",
    "arch": "depcruise features convex app types --config .dependency-cruiser.js",
    "arch:report": "depcruise features convex app types --config .dependency-cruiser.js --output-type err-html > arch-report.html; open arch-report.html"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "react-native-safe-area-context"
      ]
    }
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.99",
    "@clerk/expo": "^4.13.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-vector-icons/ionicons": "^13.1.5",
    "@sentry/react-native": "^8.31.0",
    "@tanstack/react-query": "^5.104.3",
    "@types/react-dom": "~19.3.0",
    "ai": "^7.0.143",
    "commitlint": "^21.2.3",
    "convex": "^1.47.0",
    "date-fns": "^4.1.0",
    "expo": "^58.0.14",
    "expo-auth-session": "~58.0.13",
    "expo-blur": "~58.0.4",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.23",
