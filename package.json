{
  "name": "holidai",
  "main": "index.js",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "e2e": "maestro test ./maestro",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:generate": "sb-rn-get-stories --config-path ./.rnstorybook",
    "storybook:ios": "npm run storybook:generate && EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:ios",
    "storybook:android": "npm run storybook:generate && EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:android",
    "spell-check": "cspell lint .",
    "format": "npx @biomejs/biome format --write",
    "lint": "biome check . && eslint .",
    "lint:compiler": "npx eslint \"**/*.{js,jsx,ts,tsx}\"",
    "arch": "depcruise features convex app types --config .dependency-cruiser.js",
    "arch:report": "depcruise features convex app types --config .dependency-cruiser.js --output-type err-html > arch-report.html; open arch-report.html",
    "typecheck": "tsc --noEmit",
    "check:text": "config-presets check-text",
    "check:arch": "config-presets check-deps",
    "check:i18n": "config-presets check-i18n",
    "check:unused-keys": "config-presets check-unused-keys",
    "check:hooks": "config-presets check-hooks",
    "test:coverage": "jest --coverage --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm run check:text && npm run check:arch && npm run check:i18n && npm run check:unused-keys && npm run check:hooks && npm run test",
    "prepare": "lefthook install",
    "test:watch": "jest --watchAll"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "react-native-safe-area-context"
      ]
    }
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.1",
    "@clerk/expo": "^3.5.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@sentry/react-native": "^8.19.0",
    "@tanstack/react-query": "^5.62.7",
    "@types/react-dom": "~19.2.0",
    "ai": "^6.0.3",
    "convex": "^1.38.0",
    "date-fns": "^4.1.0",
    "expo": "^57.0.0",
    "expo-auth-session": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.5",
    "expo-constants": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.6",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "i18next": "^25.10.10",
    "immer": "^10.1.1",
    "inversify": "^8.1.0",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.6.6",
    "react-native": "0.86.0",
    "react-native-calendar-picker": "^8.0.5",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-places-autocomplete": "2.5.6",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-map-link": "^3.9.0",
    "react-native-maps": "1.27.2",
    "react-native-mmkv": "^3.2.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.2.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.0",
    "reflect-metadata": "^0.2.2",
    "ts-pattern": "^5.6.2",
    "zod": "^4.2.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-class-static-block": "^7.27.1",
    "@biomejs/biome": "^2.5.3",
    "@colbymchenry/codegraph": "^1.4.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/dict-it-it": "^3.1.6",
    "@expo/config-plugins": "~57.0.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@open-pencil/cli": "^0.14.0",
    "@open-pencil/mcp": "^0.14.0",
    "@react-native/metro-config": "^0.80.0",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-ondevice-actions": "^10.5.4",
    "@storybook/addon-ondevice-controls": "^10.5.4",
    "@storybook/react-native": "^10.5.4",
    "@storybook/react-native-web-vite": "^10.5.7",
    "@timothyrusso/arch-rules": "^0.1.2",
    "@timothyrusso/config-presets": "^0.1.2",
    "@timothyrusso/eslint-plugin-arch": "^0.1.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "@types/react-native-calendar-picker": "^8.0.0",
    "@types/react-test-renderer": "^18.0.7",
    "@typescript-eslint/parser": "^8.59.1",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "cspell": "^8.17.5",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.2",
    "lefthook": "^1.11.13",
    "prettier": "^3.3.3",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.2.0",
    "storybook": "^10.5.7",
    "typescript": "~6.0.3"
  },
  "private": true
}
