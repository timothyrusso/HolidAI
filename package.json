    "@storybook/addon-ondevice-actions": "^10.7.0",
    "@storybook/addon-ondevice-controls": "^10.7.0",
    "@storybook/react-native": "^10.7.0",
    "@storybook/react-native-web-vite": "^10.6.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-native-calendar-picker": "^8.0.0",
    "@types/react-test-renderer": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.2",
    "babel-plugin-transform-typescript-metadata": "^0.4.0",
    "cspell": "^10.4.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.3.1",
    "storybook": "^10.5.7",
    "typescript": "~7.0.2"
  },
  "private": true
