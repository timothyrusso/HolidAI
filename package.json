    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "i18next": "^26.4.7",
    "immer": "^11.1.21",
    "inversify": "^8.2.3",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.0.20",
    "react-native": "0.88.0",
    "react-native-calendar-picker": "^8.0.5",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-google-places-autocomplete": "2.6.5",
    "react-native-keyboard-controller": "1.22.7",
